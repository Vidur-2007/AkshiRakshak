# Copy to .env for local development. Never commit .env.
# Groq (free tier key from console.groq.com)
GROQ_API_KEY=
# A current Groq model that supports structured JSON output
GROQ_MODEL=
# Google AI Studio free tier key
GEMINI_API_KEY=
# A current Flash or Flash-Lite model available on the free tier
GEMINI_MODEL=
# Vision-capable free-tier model (P2, /api/ai/vision)
GEMINI_VISION_MODEL=
# P2 /api/reports: Upstash Redis variables are injected by the Vercel Marketplace
# integration; use whatever names it creates (read them in one config module).
# Telegram bot (api/telegram.ts): only the webhook secret goes on the server.
# Make one with: npm run telegram:setup -- --new-secret
# The bot token from @BotFather is NOT needed here; use it only when running telegram:setup.
TELEGRAM_WEBHOOK_SECRET=
