{
  "name": "akshi-rakshak",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Akshi Rakshak — scam and fraud detector for Indian UPI users (Arthaton 2026)",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "eval"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:api\" \"npm run dev --workspaces --if-present\"",
    "dev:api": "tsx scripts/dev-api.ts",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "eval": "npm run eval --workspaces --if-present",
    "fixtures": "tsx scripts/build-fixtures.ts"
  },
  "dependencies": {
    "@akshi/contracts": "*",
    "@akshi/content": "*",
    "@akshi/engine": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
